---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/blog.css';

const posts = (await getCollection('blog'))
  .sort((a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
  );
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Blog First Step Lab | LinkedIn, Currículo e Carreira</title>

    <meta
      name="description"
      content="Conteúdos sobre LinkedIn, currículo, carreira e crescimento profissional."
    />

    <link
      rel="canonical"
      href="https://blog.firststeplab.com.br/"
    />
    
    <meta property="og:type" content = "website" />

    <meta
     property="og:title"
     content = "Blog | First Step Lab"
    />

    <meta
     property="og:description"
     content = "Conteúdos sobre LinkedIn, currículo, carreira e crescimento profissional."
    />

    <meta
     property="og:url"
     content = "https://blog.firststeplab.com.br/"
    />

    <meta
     property="og:image"
     content = "https://blog.firststeplab.com.br/og-default.jpg"
    />

  </head>

  <body class="page-blog">

    <header>
      <nav class="container">
        <a href="https://firststeplab.com.br/">Home</a>
        <a href="https://firststeplab.com.br/sobre">Sobre</a>
        <a href="/" class="active">Blog</a>
      </nav>
    </header>

    <main>

      <section class="blog-hero">
        <div class="container">

          <h1>Blog da First Step Lab</h1>

          <p>
            Conteúdos sobre carreira, LinkedIn,
            currículo, processos seletivos, comunicação e
            crescimento profissional para encurtar
            seu caminho até a vaga.
          </p>

        </div>
      </section>

      <section>
        <div class="container">

          <div class="blog-grid">

            {
              posts.map((post) => (
                <article class="blog-card">

                  <a href={`/${post.id}/`}>

                    <h2>{post.data.title}</h2>

                    <p>{post.data.description}</p>

                  </a>

                  <div class="blog-meta">

                    <span class="blog-date">
                      {new Date(post.data.date).toLocaleDateString('pt-BR')}
                    </span>

                    {post.data.tags?.map((tag) => (
                      <span class="blog-tag">{tag}</span>
                    ))}

                  </div>

                </article>
              ))
            }

          </div>

        </div>
      </section>

    </main>

  </body>
</html>