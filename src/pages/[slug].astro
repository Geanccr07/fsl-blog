<script is:inline>
  const audio = document.getElementById('blog-audio');
  const btn = document.getElementById('btn-listen');
  const textLabel = document.getElementById('audio-text');
  const iconPlay = document.querySelector('.icon-play');
  const iconPause = document.querySelector('.icon-pause');

  // Função auxiliar para formatar os segundos em MM:SS (Declarada no topo do escopo)
  function formatTime(seconds) {
    if (isNaN(seconds)) return "0:00";
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  if (audio && btn) {
    let hasStarted = false;
    let milestones = { 25: false, 50: false, 75: false, 90: false };
    const articleTitle = document.title;

    btn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        // Já exibe o tempo logo no primeiro clique para não dar delay
        textLabel.textContent = `Pausar • ${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;

        // TRACKING: audio_start
        if (!hasStarted) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'audio_start',
            audio_title: articleTitle,
            audio_url: audio.src
          });
          hasStarted = true;
        }
      } else {
        audio.pause();
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        // Ajustado para manter o tempo congelado quando o usuário pausa
        textLabel.textContent = `Continuar • ${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
      }
    });

    audio.addEventListener('ended', () => {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      textLabel.textContent = 'Ouvir novamente';
      
      // TRACKING: 100%
      window.dataLayer.push({
        event: 'audio_progress',
        audio_title: articleTitle,
        audio_percent: 100
      });
    });

    // TRACKING & ATUALIZAÇÃO DE TEMPO DINÂMICO
    audio.addEventListener('timeupdate', () => {
      if (audio.duration && !isNaN(audio.duration) && audio.duration > 0) {
        // 1. Atualiza o texto do botão em tempo real APENAS se o áudio estiver tocando
        if (!audio.paused) {
          textLabel.textContent = `Pausar • ${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
        }

        // 2. Disparos do DataLayer
        const percentage = Math.floor((audio.currentTime / audio.duration) * 100);
        [25, 50, 75, 90].forEach(marker => {
          if (percentage >= marker && !milestones[marker]) {
            milestones[marker] = true;
            window.dataLayer.push({
              event: 'audio_progress',
              audio_title: articleTitle,
              audio_percent: marker
            });
          }
        });
      }
    });

  } 
</script>

</body>
