---
import { getCollection, render } from 'astro:content';

import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

import '../styles/global.css';
import '../styles/blog.css';


export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

// Captura os dados do post atual
const { post } = Astro.props;
const { Content, headings } = await render(post);

// BUSCA A COLEÇÃO
const allBlogPosts = await getCollection('blog');

// Cálculos de tempo 
const readingTime = Math.ceil(post.body.split(' ').length / 200);
const listenTime = Math.ceil(post.body.split(' ').length / 120);

// filtro dos artigos relacionados
// Prioriza a mesma categoria (silo temático) e usa overlap de tags só como
// critério de desempate dentro do próprio cluster, não como critério principal.
const currentCategory = post.data.category;
const currentTags = post.data.tags || [];
const relatedPosts = allBlogPosts
  .filter((p) => p.id !== post.id) // Remove o artigo que está sendo lido
  .map((p) => {
    const sameCategory = p.data.category === currentCategory ? 1 : 0;
    const tagMatches = (p.data.tags || []).filter((tag) => currentTags.includes(tag)).length;
    return { post: p, sameCategory, tagMatches };
  })
  .sort((a, b) =>
    b.sameCategory - a.sameCategory ||
    b.tagMatches - a.tagMatches ||
    new Date(b.post.data.date).getTime() - new Date(a.post.data.date).getTime()
  )
  .map((item) => item.post)
  .slice(0, 3);

const pageTitle = post.data.seoTitle || post.data.title;

const ogImage = post.data.image
  ? `https://blog.firststeplab.com.br${post.data.image}`
  : "https://blog.firststeplab.com.br/og-default.jpg";

const authorKey = post.data.author || "Gean Carlos";

const authorsData = {
  "Gean Carlos": { 
    name: "Gean Carlos",
    role: "Growth Marketing Analyst • First Step Lab",
    avatar: "/gean.webp",
    bio: "Gean Carlos é Analista de Growth e fundador da First Step Lab. Compartilha conteúdos sobre LinkedIn, currículo, entrevistas e estratégias de carreira para ajudar profissionais a conquistarem vagas.",
    linkedin: "https://www.linkedin.com/in/gean-carlos-ribeiro/",
    community: "https://firststeplab.com.br/#leadForm"
  },
  "Priscila Lima": {
    name: "Priscila Lima",
    role: "Especialista em Carreira • First Step Lab",
    avatar: "/priscila.webp",
    bio: "Priscila Lima é especialista em carreira e recolocação, fundadora da GPL Consultoria de RH e formada pelo programa Gupy Experts. Com mais de 5 anos de atuação, ajuda profissionais a se posicionarem estrategicamente para conquistar novas oportunidades, com mais de 90% dos clientes recolocados no mercado de trabalho.",
    linkedin: "https://www.linkedin.com/in/admrh-gislaine-priscila-lima/",
    community: "https://firststeplab.com.br/#leadForm"
  },
  "Isabel Costa": {
    name: "Isabel Costa",
    role: "Executiva de RH, Cultura e ESG • First Step Lab",
    avatar: "/isabel.webp",
    bio: "Isabel Costa é executiva e consultora sênior com mais de 20 anos de experiência em Recursos Humanos, Cultura Organizacional e ESG, psicóloga pela UNESP e coautora do livro Liderança Humanizada. Já liderou programas que impactaram mais de 700 mil pessoas e mobilizou mais de R$ 65 milhões em investimentos sociais, unindo visão estratégica e olhar humano em decisões de liderança e contratação.",
    linkedin: "https://www.linkedin.com/in/isabel-costa-esg/",
    community: "https://firststeplab.com.br/#leadForm"
  }
};

const currentAuthor = authorsData[authorKey] || authorsData["Gean Carlos"];

---

<html lang="pt-BR">
<head>

<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-KNKLK2J8');</script>
<meta charset="UTF-8" />


  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

<title>{pageTitle}</title>

  <meta
    name="description"
    content={post.data.description}
  />

  <link
    rel="canonical"
    href={`https://blog.firststeplab.com.br/${post.id}/`}
  />

  <meta
    property="og:type"
    content="article"
  />

  <meta
    property="og:title"
    content={post.data.title}
  />

  <meta
    property="og:description"
    content={post.data.description}
  />

  <meta
    property="og:url"
    content={`https://blog.firststeplab.com.br/${post.id}/`}
  />

  <meta
    property="og:image"
    content={ogImage}
  />

  <meta
    property="og:site_name"
    content="First Step Lab"
  />

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={post.data.title}
  />

  <meta
    name="twitter:description"
    content={post.data.description}
  />

  <meta
    name="twitter:image"
    content={ogImage}
  />

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",

    headline: post.data.title,
    description: post.data.description,

    image: ogImage,

    author: {
      "@type": "Person",
      name: post.data.author
    },

    publisher: {
      "@type": "Organization",
      name: "First Step Lab"
    },

    datePublished: post.data.date,
    dateModified: post.data.date,

    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `https://blog.firststeplab.com.br/${post.id}/`
    },

    url: `https://blog.firststeplab.com.br/${post.id}/`
  })}
/>
</head>

<body class="page-blog">

<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KNKLK2J8"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

<header>
  <nav class="container">
    <a href="https://firststeplab.com.br/">Home</a>
    <a href="https://firststeplab.com.br/sobre">Sobre</a>
    <a href="/" class="active">Blog</a>
  </nav>

</header>

<div class="progress-container">
  <div class="progress-bar" id="reading-bar"></div>
</div>

<main class="blog-post">

  {
    post.data.image && (
      <img
        src={post.data.image}
        alt={post.data.title}
        class="hero-full"
      />
    )
  }

  <div class="container">
    <article>
      <section class="article-hero">
        <h1>{post.data.title}</h1>

        <div class="author-box">
          <img
            src={post.data.authorImage}
            alt={post.data.author}
            class="author-avatar"
          />

          <div class="author-info">
            <strong>{post.data.author}</strong>
            <span>{post.data.authorRole}</span>
            <span>{readingTime} minutos de leitura </span>
          </div>
        </div>

        <p class="article-description">
          {post.data.description}
        </p>

        {post.data.audio_url && (
          <div class="audio-player-container">
            <audio id="blog-audio" src={post.data.audio_url}></audio>
        
            <button id="btn-listen" class="audio-btn">
              <svg class="icon-play" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
              <svg class="icon-pause hidden" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              <span id="audio-text">Clique aqui para ouvir</span>
            </button>
          </div>
        )}
      </section>

      {
        headings.length > 0 && (
          <aside class="table-of-contents">
            <h2>Neste artigo</h2>
            <ul>
              {
                headings
                  .filter(h => h.depth === 2)
                  .map(h => (
                    <li>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))
              }
            </ul>
          </aside>
        )
      }

      <div class="article-body">
        <Content />
      </div>

      {
        post.data.cta_text && post.data.cta_url && (
          <div class="post-cta">
            <a href={post.data.cta_url} class="post-cta-btn">
              {post.data.cta_text}
            </a>
          </div>
        )
      }
    </article>
  </div> 

<section class="author-bio-wrapper">
    <div class="author-bio">
      <div class="author-bio-left">
        <img src={currentAuthor.avatar} alt={currentAuthor.name} class="author-bio-avatar" />
        <div class="author-bio-meta">
          <h3>{currentAuthor.name}</h3>
          <span>{currentAuthor.role}</span>
        </div>
      </div>

      <div class="author-bio-right">
        <h2>Quem escreveu este artigo</h2>
        <p>{currentAuthor.bio}</p>

        <div class="author-links">
          <a href={currentAuthor.linkedin} target="_blank">LinkedIn</a>
          <a href={currentAuthor.community} target="_blank">Comunidade gratuita</a>
        </div>
      </div>
    </div>
  </section>


{relatedPosts.length > 0 && (
    <section class="related-posts-section">
      <div class="container">
        <h2>Conteúdos semelhantes para você</h2>
        
        <div class="related-posts-grid">
          {relatedPosts.map((related) => (
            <article class="related-card">
              {related.data.image && (
                <a href={`/${related.id}/`} class="related-card-image-link">
                  <img src={related.data.image} alt={related.data.title} loading="lazy" />
                </a>
              )}

              <div class="related-card-content">
                <div class="related-card-tags">
                  {(related.data.tags || []).slice(0, 2).map(tag => (
                    <span class="tag-badge">{tag}</span>
                  ))}
                </div>

                <h3>
                  <a href={`/${related.id}/`}>
                    {related.data.title}
                  </a>
                </h3>

                <p>{related.data.description}</p>

                <a href={`/${related.id}/`} class="related-read-more">
                  Acessar →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

</main> <footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="footer-logo">First Step Lab</span>
      <p class="footer-tagline">O caminho mais curto para conseguir sua próxima vaga de emprego</p>
    </div>
    
    <div class="footer-nav">
      <h3>Navegação</h3>
      <a href="https://firststeplab.com.br/">Home</a>
      <a href="https://firststeplab.com.br/sobre">Sobre</a>
      <a href="https://blog.firststeplab.com.br/">Blog</a>
    </div>
    
    <div class="footer-social">
      <h3>Contato</h3>
      <a href="https://www.linkedin.com/company/first-step-lab" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://www.instagram.com/firststep.lab/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://wa.me/5542988071146?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20FSL%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es." target="_blank" rel="noopener" class="whats-highlight">Falar no WhatsApp</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 First Step Lab. Todos os direitos reservados.</p>
    <div class="footer-legal">
      <a href="https://firststeplab.com.br/politica-de-privacidade">Privacidade</a>
      <a href="https://firststeplab.com.br/termos-de-uso">Termos de Uso</a>
    </div>
  </div>
</footer>

  <button id="theme-toggle" class="theme-toggle" aria-label="Mudar tema">
  <svg class="icon-theme id-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
  <svg class="icon-theme id-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
  </button> 

<script is:inline>

  // ==========================================
  // 1. CONTROLE E TRACKING DO AUDIO PLAYER
  // ==========================================
  const audio = document.getElementById('blog-audio');
  const btn = document.getElementById('btn-listen');
  const textLabel = document.getElementById('audio-text');
  const iconPlay = document.querySelector('.icon-play');
  const iconPause = document.querySelector('.icon-pause');

  // Função auxiliar para formatar os segundos em MM:SS
  function formatTime(seconds) {
    if (isNaN(seconds)) return "0:00";
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  if (audio && btn) {
    let hasStarted = false;
    let milestones = { 25: false, 50: false, 75: false, 90: false };
    const articleTitle = document.title;

    btn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
        iconPlay.classList.add('hidden');
        iconPause.classList.remove('hidden');
        textLabel.textContent = `Pausar • ${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;

        // TRACKING: audio_start
        if (!hasStarted) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'audio_start',
            audio_title: articleTitle,
            audio_url: audio.src
          });
          hasStarted = true;
        }
      } else {
        audio.pause();
        iconPlay.classList.remove('hidden');
        iconPause.classList.add('hidden');
        textLabel.textContent = `Continuar • ${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
      }
    });

    audio.addEventListener('ended', () => {
      iconPlay.classList.remove('hidden');
      iconPause.classList.add('hidden');
      textLabel.textContent = 'Ouvir novamente';
      
      // TRACKING: 100%
      window.dataLayer.push({
        event: 'audio_progress',
        audio_title: articleTitle,
        audio_percent: 100
      });
    });

    // TRACKING & ATUALIZAÇÃO DE TEMPO DINÂMICO
    audio.addEventListener('timeupdate', () => {
      if (audio.duration && !isNaN(audio.duration) && audio.duration > 0) {
        // 1. Atualiza o texto do botão em tempo real APENAS se o áudio estiver tocando
        if (!audio.paused) {
          textLabel.textContent = `Pausar • ${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
        }

        // 2. Disparos do DataLayer
        const percentage = Math.floor((audio.currentTime / audio.duration) * 100);
        [25, 50, 75, 90].forEach(marker => {
          if (percentage >= marker && !milestones[marker]) {
            milestones[marker] = true;
            window.dataLayer.push({
              event: 'audio_progress',
              audio_title: articleTitle,
              audio_percent: marker
            });
          }
        });
      }
    });
  } 

  // ==========================================
  // 2. BARRA DE PROGRESSO DE LEITURA 
  // ==========================================

  window.addEventListener('scroll', () => {
    const bar = document.getElementById('reading-bar');
    const article = document.querySelector('.blog-post article');
    
    if (bar && article) {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const articleTop = article.offsetTop;
      const articleHeight = article.offsetHeight;
      const windowHeight = window.innerHeight;

      // Se o usuário ainda não chegou de fato no bloco do artigo, mantém zerada
      if (scrollTop < articleTop) {
        bar.style.width = '0%';
        return;
      }

      // Calcula o progresso real baseado única e exclusivamente na caixa do artigo
      let scrolled = (scrollTop - articleTop) / (articleHeight - windowHeight) * 100;
      

      if (scrolled < 0) scrolled = 0;
      if (scrolled > 100) scrolled = 100;
      
      bar.style.width = scrolled + '%';
    }
  });

  // ==========================================
  // 3. LOGICA GLOBAL DE TEMA (DARK / LIGHT)
  // ==========================================
  
  const getTheme = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme');
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  if (getTheme() === 'dark') {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });
</script>

</body>
</html>