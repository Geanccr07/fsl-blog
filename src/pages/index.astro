---
import { getCollection } from 'astro:content';
// 🚀 ADICIONADO: Importando as fontes locais Poppins
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

import '../styles/global.css';
import '../styles/blog.css';

const posts = (await getCollection('blog'))
  .sort((a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
  );

// Paginação da raiz: página 1 fica em "/", as seguintes em "/pagina/2/", "/pagina/3/" etc.
const PAGE_SIZE = 9;
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const pagePosts = posts.slice(0, PAGE_SIZE);

const authors = {
  "Gean Carlos": {
    name: "Gean Carlos",
    role: "Cofundador • First Step Lab",
    avatar: "/gean.webp",
    bio: "Analista de Growth e fundador da First Step Lab. Escreve sobre LinkedIn, currículo, entrevistas e estratégia de candidatura.",
    linkedin: "https://www.linkedin.com/in/gean-carlos-ribeiro/",
  },
  "Priscila Lima": {
    name: "Priscila Lima",
    role: "Especialista em Carreira • First Step Lab",
    avatar: "/priscila.webp",
    bio: "Especialista em carreira e recolocação, fundadora da GPL Consultoria de RH e formada pelo programa Gupy Experts. Mais de 90% dos clientes recolocados.",
    linkedin: "https://www.linkedin.com/in/admrh-gislaine-priscila-lima/",
  },
  "Isabel Costa": {
    name: "Isabel Costa",
    role: "Executiva de RH, Cultura e ESG • First Step Lab",
    avatar: "/isabel.webp",
    bio: "Executiva e consultora sênior com mais de 20 anos em Recursos Humanos, Cultura Organizacional e ESG. Coautora do livro Liderança Humanizada, já liderou programas que impactaram mais de 700 mil pessoas.",
    linkedin: "https://www.linkedin.com/in/isabel-costa-esg/",
  },
};

// Contagem de artigos por autor: dado que já vem do getCollection acima,
// sem custo extra de fetch/build, só um reduce sobre o array em memória.
// Cai em "Gean Carlos" se o author do frontmatter não bater com nenhum
// cadastrado aqui (mesmo fallback usado em [slug].astro).
const articleCountByAuthor = posts.reduce((acc, post) => {
  const rawKey = post.data.author || "Gean Carlos";
  const key = authors[rawKey] ? rawKey : "Gean Carlos";
  acc[key] = (acc[key] || 0) + 1;
  return acc;
}, {});
---

