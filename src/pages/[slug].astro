---
import { getCollection, render } from 'astro:content';
import '../styles/global.css';
import '../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const readingTime = Math.ceil(post.body.split(' ').length / 200);
const listenTime = Math.ceil(post.body.split(' ').length / 120);

// 1. Usa o seoTitle (se você criar um específico), senão usa o título padrão
const baseTitle = post.data.seoTitle || post.data.title;

// 2. Monta o título com a marca
let pageTitle = `${baseTitle}`;

// 3. Se passar de 60 caracteres, remove o nome da marca para não estourar no Google
if (pageTitle.length > 60) {
  pageTitle = baseTitle; 
}

