---
import { getCollection } from 'astro:content';
// 🚀 ADICIONADO: Importando as fontes locais Poppins
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

import '../styles/global.css';
import '../styles/blog.css';

const posts = (await getCollection('blog'))
  .sort((a, b) =>
    new Date(b.data.date).getTime() -
    new Date(a.data.date).getTime()
  );
---

<html lang="pt-BR">
  <head>

    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KNKLK2J8');</script>
    <!-- End Google Tag Manager -->

    <meta charset="UTF-8" />


    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Blog First Step Lab | LinkedIn, Currículo e Carreira</title>

    <meta
      name="description"
      content="Conteúdos sobre LinkedIn, currículo, carreira e crescimento profissional."
    />

    <link
      rel="canonical"
      href="https://blog.firststeplab.com.br/"
    />
    
    <meta property="og:type" content = "website" />

    <meta
     property="og:title"
     content = "Blog | First Step Lab"
    />

    <meta
     property="og:description"
     content = "Conteúdos sobre LinkedIn, currículo, carreira e crescimento profissional."
    />

    <meta
     property="og:url"
     content = "https://blog.firststeplab.com.br/"
    />

    <meta
     property="og:image"
     content = "https://blog.firststeplab.com.br/og-default.jpg"
    />

  </head>

  <body class="page-blog">

  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KNKLK2J8"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

    <header>
      <nav class="container">
        <a href="https://firststeplab.com.br/">Home</a>
        <a href="https://firststeplab.com.br/sobre">Sobre</a>
        <a href="/" class="active">Blog</a>
      </nav>
    </header>

    <main>

      <section class="blog-hero">
        <div class="container">

          <h1>Blog da First Step Lab</h1>

          <p>
            Conteúdos sobre carreira, LinkedIn,
            currículo, processos seletivos, comunicação e
            crescimento profissional para encurtar
            seu caminho até a vaga.
          </p>

        </div>
      </section>

      <section>
        <div class="container">

<div class="blog-grid">

            {
              posts.map((post, index) => (
                <article class="blog-card">

                  <a href={`/${post.id}/`} class="blog-card-image-link">
                    <img 
                      src={post.data.image} 
                      alt={`Capa do artigo: ${post.data.title}`}

                      loading={index < 3 ? "eager" : "lazy"}

                      width="600"
                      height="257"
                    />
                  </a>

                  <a href={`/${post.id}/`}>

                    <h2>{post.data.title}</h2>

                    <p>{post.data.description}</p>

                  </a>

                  <div class="blog-meta">

                    <span class="blog-date">
                      {new Date(post.data.date).toLocaleDateString('pt-BR')}
                    </span>

                    {post.data.tags?.map((tag) => (
                      <span class="blog-tag">{tag}</span>
                    ))}

                  </div>

                </article>
              ))
            }

          </div>

        </div>
      </section>

</main> <footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <span class="footer-logo">First Step Lab</span>
      <p class="footer-tagline">O caminho mais curto para conseguir sua próxima vaga de emprego</p>
    </div>
    
    <div class="footer-nav">
      <h3>Navegação</h3>
      <a href="https://firststeplab.com.br/">Home</a>
      <a href="https://firststeplab.com.br/sobre">Sobre</a>
      <a href="https://blog.firststeplab.com.br/">Blog</a>
    </div>
    
    <div class="footer-social">
      <h3>Contato</h3>
      <a href="https://www.linkedin.com/company/first-step-lab" target="_blank" rel="noopener">LinkedIn</a>
      <a href="https://www.instagram.com/firststep.lab/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://wa.me/5542988071146?text=Ol%C3%A1!%20Vim%20pelo%20site%20da%20FSL%20e%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es." target="_blank" rel="noopener" class="whats-highlight">Falar no WhatsApp</a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© 2026 First Step Lab. Todos os direitos reservados.</p>
    <div class="footer-legal">
      <a href="https://firststeplab.com.br/politica-de-privacidade">Privacidade</a>
      <a href="https://firststeplab.com.br/termos-de-uso">Termos de Uso</a>
    </div>
  </div>
</footer>

  </body>
</html>