---
import { getCollection, render } from 'astro:content';
import '../styles/global.css';
import '../styles/blog.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const readingTime = Math.ceil(post.body.split(' ').length / 200);

// LÓGICA DE SEO PARA O TÍTULO
// 1. Usa o seoTitle (se você criar um específico), senão usa o título padrão
const baseTitle = post.data.seoTitle || post.data.title;

// 2. Monta o título com a marca
let pageTitle = `${baseTitle} | First Step Lab`;

// 3. Se passar de 60 caracteres, remove o nome da marca para não estourar no Google
if (pageTitle.length > 60) {
  pageTitle = baseTitle; 
}
---

<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

<title>{pageTitle}</title>

  <meta
    name="description"
    content={post.data.description}
  />

  <!-- Canonical -->
  <link
    rel="canonical"
    href={`https://blog.firststeplab.com.br/${post.id}/`}
  />

  <!-- Open Graph -->
  <meta
    property="og:type"
    content="article"
  />

  <meta
    property="og:title"
    content={post.data.title}
  />

  <meta
    property="og:description"
    content={post.data.description}
  />

  <meta
    property="og:url"
    content={`https://blog.firststeplab.com.br/${post.id}/`}
  />

  <meta
    property="og:image"
    content="https://blog.firststeplab.com.br/og-default.jpg"
  />

  <meta
    property="og:site_name"
    content="First Step Lab"
  />

  <!-- Twitter -->
  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={post.data.title}
  />

  <meta
    name="twitter:description"
    content={post.data.description}
  />

  <meta
    name="twitter:image"
    content="https://blog.firststeplab.com.br/og-default.jpg"
  />

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",

    headline: post.data.title,
    description: post.data.description,

    image: "https://blog.firststeplab.com.br/og-default.jpg",

    author: {
      "@type": "Organization",
      name: "First Step Lab"
    },

    publisher: {
      "@type": "Organization",
      name: "First Step Lab"
    },

    datePublished: post.data.date,

    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": `https://blog.firststeplab.com.br/${post.id}/`
    },

    url: `https://blog.firststeplab.com.br/${post.id}/`
  })}
/>
</head>

<body class="page-blog">

<header>
  <nav class="container">
    <a href="https://firststeplab.com.br/">Home</a>
    <a href="https://firststeplab.com.br/sobre">Sobre</a>
    <a href="/" class="active">Blog</a>
  </nav>
</header>

<main class="blog-post">

  {
    post.data.image && (
      <img
        src={post.data.image}
        alt={post.data.title}
        class="hero-full"
      />
    )
  }

  <div class="container">

    <article>

      <section class="article-hero">

        <h1>{post.data.title}</h1>

        <div class="author-box">

          <img
            src={post.data.authorImage}
            alt={post.data.author}
            class="author-avatar"
          />

          <div class="author-info">

            <strong>
              {post.data.author}
            </strong>

            <span>
              {post.data.authorRole}
            </span>

            <span>
              {readingTime} min de leitura
            </span>

          </div>

        </div>

        <p class="article-description">
          {post.data.description}
        </p>

      </section>

{
  headings.length > 0 && (
    <aside class="table-of-contents">

      <h2>Neste artigo</h2>

      <ul>
        {
          headings
            .filter(h => h.depth === 2)
            .map(h => (
              <li>
                <a href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))
        }
      </ul>

    </aside>
  )
}

      <Content />

      {
        post.data.cta_text && post.data.cta_url && (
          <div class="post-cta">

            <a
              href={post.data.cta_url}
              class="post-cta-btn"
            >
              {post.data.cta_text}
            </a>

          </div>
        )
      }


<section class="author-bio">

  <img
    src="/gean.jpg"
    alt="Gean Carlos"
    class="author-bio-avatar"
  />

  <div class="author-bio-content">

    <h2>Sobre o Autor</h2>

    <h3>Gean Carlos</h3>

    <p>
      Analista de Growth e fundador da First Step Lab.
      Compartilha conteúdos sobre LinkedIn,
      currículo, entrevistas e estratégias
      de carreira para ajudar profissionais
      a conquistarem suas vagas.
    </p>

    <div class="author-links">

      <a
        href="https://www.linkedin.com/in/gean-carlos-ribeiro/"
        target="_blank"
      >
        Se conecte comigo no LinkedIn
      </a>

      <a
        href="https://firststeplab.com.br/#leadForm"
        target="_blank"
      >
        Faça parte da nossa comunidade gratuita
      </a>

    </div>

  </div>

</section>

    </article>

  </div>

</main>

</body>
</html>